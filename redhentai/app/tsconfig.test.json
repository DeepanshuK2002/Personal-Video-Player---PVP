{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": ".test-build",
    "rootDir": "src"
  },
  "include": ["src/lib/providers/__tests__/**/*.ts"]
}
