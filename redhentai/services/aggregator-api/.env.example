# RedHentai Aggregator API - Environment Configuration
# Copy this to .env and adjust values

# App
APP_NAME=RedHentai Aggregator API
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8766

# CORS (for frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis Cache (optional - uses in-memory if not set)
REDIS_URL=redis://localhost:6379/0

# Cache TTLs (seconds)
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=10000

# Rate Limiting
GLOBAL_RATE_LIMIT=300
BURST_ALLOWANCE=50

# Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30

# Provider Configs
MANGADEX_ENABLED=true
MANGADEX_BASE_URL=https://api.mangadex.org
MANGADEX_TIMEOUT=15.0

ANILIST_ENABLED=true
ANILIST_BASE_URL=https://graphql.anilist.co
ANILIST_TIMEOUT=20.0

HENTAIREAD_ENABLED=true
HENTAIREAD_BASE_URL=https://hentairead.io
HENTAIREAD_TIMEOUT=20.0

HENTAI18_ENABLED=true
HENTAI18_BASE_URL=https://hentai18.net
HENTAI18_TIMEOUT=20.0

ENMA_ENABLED=true
ENMA_BASE_URL=http://127.0.0.1:8765
ENMA_TIMEOUT=30.0

HENTAIREADMOE_ENABLED=true
HENTAIREADMOE_BASE_URL=https://hentairead.moe
HENTAIREADMOE_TIMEOUT=20.0

OMEGASCANS_ENABLED=false
HIPERDEX_ENABLED=false

# Adult Content Policy
ALLOW_CONFIRMED_ADULT=true
ALLOW_MATURE=true
ALLOW_UNKNOWN=false

# Matching
MATCH_THRESHOLD=0.55

# Cache TTLs by operation
CACHE_TTL_SEARCH=300
CACHE_TTL_DETAIL=3600
CACHE_TTL_CHAPTERS=1800
CACHE_TTL_PAGES=86400
CACHE_TTL_TRENDING=600
CACHE_TTL_LATEST=300